{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "libs/ui/**/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/environments/environment.development.ts",
    "src/environments/environment.local.generated.ts"
  ]
}
