{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "doctorchart-frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/styles-m3.css",
              "src/styles-dark.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "static"
          },
          "configurations": {
            "m6-lab": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputPath": ".angular/m6-lab",
              "fileReplacements": [{"replace":"src/environments/environment.ts","with":"src/environments/environment.m6.generated.ts"}]
            },
            "manual-lab": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false,
              "fileReplacements": [{"replace":"src/environments/environment.ts","with":"src/environments/environment.manual.generated.ts"}]
            },
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "25kB",
                  "maximumError": "35kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "fonts": false,
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.deploy.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "deployment": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.deploy.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "build-demo": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.demo.ts",
            "index": {
              "input": "src/index.demo.html",
              "output": "index.html"
            },
            "tsConfig": "tsconfig.demo.json",
            "outputPath": "dist/demochart",
            "fileReplacements": [
              {
                "replace": "src/environments/environment.ts",
                "with": "src/demo/environment.demo.ts"
              }
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "hosting/demochart",
                "output": "/"
              },
              {
                "glob": "doctorchart-logo.svg",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "bycode-logo.svg",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "favicon.ico",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "theme-init.js",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "public/fonts",
                "output": "/fonts"
              },
              {
                "glob": "**/*",
                "input": "public/help",
                "output": "/help"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/styles-m3.css",
              "src/styles-dark.css"
            ],
            "outputHashing": "all",
            "optimization": {
              "fonts": false,
              "styles": {
                "inlineCritical": false
              }
            }
          },
          "configurations": {
            "production": {},
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4202
          },
          "configurations": {
            "production": {
              "buildTarget": "doctorchart-frontend:build:production"
            },
            "development": {
              "buildTarget": "doctorchart-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "serve-demo": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4204
          },
          "configurations": {
            "production": {
              "buildTarget": "doctorchart-frontend:build-demo:production"
            },
            "development": {
              "buildTarget": "doctorchart-frontend:build-demo:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
